<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_home_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/gray1"
    android:paddingBottom="20dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_home_cardview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        app:cardCornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_home_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            tools:src="@drawable/all_recipe_thumbnail" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_home_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="false"
        android:textAppearance="@style/Bold.Body4"
        app:layout_constraintStart_toStartOf="@id/cv_home_cardview"
        app:layout_constraintTop_toBottomOf="@id/cv_home_cardview"
        tools:text="@string/all_recipe_name" />

    <TextView
        android:id="@+id/tv_home_able_vegan_type_one"
        style="@style/LactoOvoTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/Regular.Body5"
        app:layout_constraintStart_toStartOf="@id/tv_home_title"
        app:layout_constraintTop_toBottomOf="@id/tv_home_title" />

    <TextView
        android:id="@+id/tv_home_able_vegan_type_two"
        style="@style/PescoTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:textAppearance="@style/Regular.Body5"
        app:layout_constraintStart_toEndOf="@id/tv_home_able_vegan_type_one"
        app:layout_constraintTop_toTopOf="@id/tv_home_able_vegan_type_one" />

</androidx.constraintlayout.widget.ConstraintLayout>