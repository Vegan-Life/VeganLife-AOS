<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sub_gray1"
    tools:context=".recipe.ui.view.RecipeDetailInfoFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_recipe_toolbar"
        style="@style/ToolbarTheme"
        android:background="@color/gray1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/menu_all"
        app:navigationIcon="@drawable/all_back"
        app:title="@string/recipe_recipe" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/sub_gray1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_recipe_toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_recipe_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@color/gray1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_recipe_modify"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/all_vegan_type_ovo_background"
                    android:includeFontPadding="false"
                    android:text="@string/recipe_button_modify"
                    android:textAppearance="@style/Regular.Body5"
                    android:textColor="@color/gray1"
                    app:layout_constraintBottom_toBottomOf="@id/tv_recipe_delete"
                    app:layout_constraintEnd_toStartOf="@id/tv_recipe_delete"
                    app:layout_constraintTop_toTopOf="@id/tv_recipe_delete" />

                <TextView
                    android:id="@+id/tv_recipe_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="26dp"
                    android:background="@drawable/all_delete_background"
                    android:includeFontPadding="false"
                    android:text="@string/recipe_button_delete"
                    android:textAppearance="@style/Regular.Body5"
                    android:textColor="@color/gray1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vp_recipe_image"
                    android:layout_width="0dp"
                    android:layout_height="288dp"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="15dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_recipe_modify" />

                <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                    android:id="@+id/di_recipe_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:dotsColor="@color/gray2"
                    app:dotsCornerRadius="0dp"
                    app:dotsSize="8dp"
                    app:dotsSpacing="4dp"
                    app:dotsWidthFactor="4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/vp_recipe_image"
                    app:progressMode="true"
                    app:selectedDotColor="@color/base1"
                    tools:visibility="visible" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_recipe_like"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:layout_marginEnd="24dp"
                    android:backgroundTint="@color/gray1"
                    app:layout_constraintBottom_toBottomOf="@id/tv_recipe_recipe_name"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/vp_recipe_image"
                    tools:src="@drawable/all_like_empty_recipe"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tv_recipe_recipe_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/Bold.Body3"
                    android:textColor="@color/gray5"
                    app:layout_constraintStart_toStartOf="@id/vp_recipe_image"
                    app:layout_constraintTop_toBottomOf="@id/vp_recipe_image"
                    tools:text="@string/all_recipe_name" />

                <TextView
                    android:id="@+id/tv_recipe_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:includeFontPadding="false"
                    android:paddingBottom="16dp"
                    android:textAppearance="@style/Bold.Body6"
                    app:layout_constraintStart_toStartOf="@id/tv_recipe_recipe_name"
                    app:layout_constraintTop_toBottomOf="@id/tv_recipe_recipe_name"
                    tools:text="@string/all_nickname" />

                <TextView
                    android:id="@+id/tv_recipe_vegan_type"
                    style="@style/OvoTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginBottom="16dp"
                    android:textAppearance="@style/Regular.Body7"
                    app:layout_constraintBottom_toBottomOf="@id/tv_recipe_nickname"
                    app:layout_constraintStart_toEndOf="@id/tv_recipe_nickname"
                    app:layout_constraintTop_toTopOf="@id/tv_recipe_nickname" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_recipe_able_vegan_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/gray1"
                android:paddingBottom="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_recipe_info">

                <TextView
                    android:id="@+id/tv_recipe_able_vegan_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="26dp"
                    android:layout_marginTop="20dp"
                    android:includeFontPadding="false"
                    android:text="@string/recipe_able_vegan_type"
                    android:textAppearance="@style/Bold.Body6"
                    android:textColor="@color/base3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_recipe_able_vegan_type_one"
                    style="@style/LactoOvoTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="@id/tv_recipe_able_vegan_type"
                    app:layout_constraintTop_toBottomOf="@id/tv_recipe_able_vegan_type" />

                <TextView
                    android:id="@+id/tv_recipe_able_vegan_type_two"
                    style="@style/PescoTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:layout_constraintStart_toEndOf="@id/tv_recipe_able_vegan_type_one"
                    app:layout_constraintTop_toBottomOf="@id/tv_recipe_able_vegan_type_one"
                    app:layout_constraintTop_toTopOf="@id/tv_recipe_able_vegan_type_one" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_recipe_able_vegan_type">

                <LinearLayout
                    android:id="@+id/ll_recipe_ingredient"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_recipe_ingredient_tap"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:animateLayoutChanges="true"
                        android:background="@color/gray1"
                        android:paddingVertical="20dp">

                        <TextView
                            android:id="@+id/tv_recipe_ingredient"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:includeFontPadding="false"
                            android:text="@string/recipe_ingredients"
                            android:textAppearance="@style/Bold.Body6"
                            android:textColor="@color/base3"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:includeFontPadding="false"
                            android:text="@string/recipe_ingredients_for_one"
                            android:textAppearance="@style/Regular.Body5"
                            android:textColor="@color/gray4"
                            app:layout_constraintStart_toEndOf="@id/tv_recipe_ingredient"
                            app:layout_constraintTop_toTopOf="@id/tv_recipe_ingredient" />

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/btn_recipe_ingredient"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="34dp"
                            android:background="@drawable/recipe_down"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_recipe_ingredient"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/gray1"
                        android:paddingBottom="24dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_recyclerview_expandablelayout_ingredients" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_recipe_recipe"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ll_recipe_ingredient">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_recipe_description_tap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:background="@color/gray1"
                        android:paddingVertical="20dp">

                        <TextView
                            android:id="@+id/tv_recipe_description"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:includeFontPadding="false"
                            android:text="@string/recipe_recipe"
                            android:textAppearance="@style/Bold.Body6"
                            android:textColor="@color/base3"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/btn_recipe_description"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="34dp"
                            android:background="@drawable/recipe_down"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_recipe_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/gray1"
                        android:paddingBottom="24dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_recyclerview_expandablelayout_descriptions" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>