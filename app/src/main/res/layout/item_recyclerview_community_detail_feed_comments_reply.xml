<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:background="@color/gray1">

    <View
        android:id="@+id/view"
        android:layout_width="24dp"
        android:layout_height="0dp"
        android:background="@color/base2"
        android:layout_marginTop="-12dp"
        android:layout_marginBottom="-12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_community_detail_feed_comments_nickname"
        app:layout_constraintBottom_toBottomOf="@id/tv_community_detail_feed_comments_reply_description"/>

    <TextView
        android:id="@+id/tv_community_detail_feed_comments_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:includeFontPadding="false"
        android:text="@string/all_nickname"
        android:textAppearance="@style/Bold.Body6"
        android:textColor="@color/gray5"
        app:layout_constraintStart_toEndOf="@id/view"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="100dp" />

    <TextView
        android:id="@+id/tv_community_detail_feed_comments_reply_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:includeFontPadding="false"
        android:text="@string/alarm_time"
        android:textAppearance="@style/Regular.Body7"
        android:textColor="@color/sub_gray3"
        app:layout_constraintBottom_toBottomOf="@id/tv_community_detail_feed_comments_nickname"
        app:layout_constraintStart_toEndOf="@id/tv_community_detail_feed_comments_nickname"
        app:layout_constraintTop_toTopOf="@id/tv_community_detail_feed_comments_nickname" />


    <TextView
        android:id="@+id/tv_community_detail_feed_comments_reply_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="12dp"
        android:includeFontPadding="false"
        android:textAppearance="@style/Regular.Body5"
        android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do~"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_community_detail_feed_comments_nickname"
        app:layout_constraintTop_toBottomOf="@id/tv_community_detail_feed_comments_nickname"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>
