<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/gray1"
    android:layout_marginBottom="2dp"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_community_detail_feed_comments_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:includeFontPadding="false"
        android:text="@string/all_nickname"
        android:textAppearance="@style/Bold.Body6"
        android:textColor="@color/gray5"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="76dp" />

    <TextView
        android:id="@+id/tv_community_detail_feed_comments_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:includeFontPadding="false"
        android:text="@string/alarm_time"
        android:textAppearance="@style/Regular.Body7"
        android:textColor="@color/sub_gray3"
        app:layout_constraintBottom_toBottomOf="@id/tv_community_detail_feed_comments_nickname"
        app:layout_constraintStart_toEndOf="@id/tv_community_detail_feed_comments_nickname"
        app:layout_constraintTop_toTopOf="@id/tv_community_detail_feed_comments_nickname" />


    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/ib_community_detail_feed_comments_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@android:color/transparent"
        android:padding="8dp"
        android:src="@drawable/community_comments_empty"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_community_detail_feed_comments_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:includeFontPadding="false"
        android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do~"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_community_detail_feed_comments_nickname"
        app:layout_constraintTop_toBottomOf="@id/tv_community_detail_feed_comments_nickname"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>
